{
  "name": "cipi/agent",
  "description": "Cipi Agent for Laravel — webhook deploy, health check, MCP server, cipi.yml tooling and database anonymizer",
  "keywords": [
    "cipi",
    "laravel",
    "deploy",
    "mcp",
    "anonymizer",
    "cli",
    "php",
    "lemp",
    "server",
    "linux"
  ],
  "license": "MIT",
  "homepage": "https://cipi.sh/docs/agent",
  "support": {
    "docs": "https://cipi.sh/docs/agent",
    "issues": "https://github.com/cipi-sh/agent/issues",
    "source": "https://github.com/cipi-sh/agent"
  },
  "authors": [
    {
      "name": "Andrea Pollastri",
      "homepage": "https://web.ap.it"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "fakerphp/faker": "^1.23"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0"
  },
  "suggest": {
    "cipi/sdk": "Lets the MCP server and the Artisan commands talk to the Cipi panel API (deploy audit, rollback, backups, server status) — ^1.0",
    "ext-zlib": "Required for gzip-compressed anonymized dumps (--gzip)."
  },
  "autoload": {
    "psr-4": {
      "Cipi\\Agent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cipi\\Agent\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cipi\\Agent\\Providers\\CipiAgentServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
